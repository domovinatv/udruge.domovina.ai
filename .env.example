# Kopiraj u .env. Pipeline radi BEZ ijednog ključa; ovo su samo opcije.

# Kontakt u User-Agent headeru prema data.gov.hr / DGU / RNO (pristojnost, ne auth).
CONTACT_EMAIL=stepanic.matija@gmail.com

# Granice naselja/županija/biskupija (GeoJSON) iz sestrinskog repoa — default je
# ../karta-hrvatske/apps/karta-web/public/data. Bez njih pipeline radi, ali
# nema težišta naselja kao fallbacka geokodiranja ni dodjele biskupije.
# KARTA_DATA_DIR=/putanja/do/karta-web/public/data
